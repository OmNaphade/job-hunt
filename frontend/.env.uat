# Loaded by `vite build --mode uat` / `vite dev --mode uat`.
# Blank VITE_API_BASE_URL means the browser calls whatever origin serves the page,
# and Caddy reverse-proxies /api/* to the UAT api-gateway - same pattern as prod,
# it keeps CORS out of the picture. Only needed for a non-Docker UAT frontend build;
# the Docker build path gets this from env/uat.env instead (see docker-compose.yml).
VITE_API_BASE_URL=
VITE_ALLOW_SELF_REGISTER=true
VITE_ZIPKIN_URL=
