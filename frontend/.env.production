# Loaded by `vite build` (default mode is "production").
# Blank VITE_API_BASE_URL means the browser calls whatever origin serves the page,
# and Caddy reverse-proxies /api/* to api-gateway on that same origin - avoids CORS
# entirely. Only needed for a non-Docker prod frontend build; the Docker build path
# gets this from env/prod.env instead (see docker-compose.yml).
VITE_API_BASE_URL=
VITE_ALLOW_SELF_REGISTER=false
VITE_ZIPKIN_URL=
