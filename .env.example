JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAIL_USERNAME=noreply@yourapp.com
MAIL_PASSWORD=your-email-app-password
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
FINDWORK_API_KEY=your-findwork-api-key
JOBDATALAKE_API_KEY=your-jobdatalake-api-key
# Redis (query cache). In Docker Compose this is set to redis/6379 automatically; only needed here for
# running services from source (see STARTUP.md).
REDIS_HOST=localhost
REDIS_PORT=6379
