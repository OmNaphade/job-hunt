# DEV environment - local machine / laptop.
# Copy to env/dev.env and fill in real values. env/dev.env is gitignored - never commit it.
# Usage: docker compose --env-file env/dev.env -p jobportal-dev up -d --build

SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=jobapp_dev_db

JWT_SECRET=dev-only-secret-key-not-for-real-use-32chars
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@jobportal.local
ADMIN_SEED_PASSWORD=Pass123!

MAIL_USERNAME=noreply@jobportal.local
MAIL_PASSWORD=

# Optional job-source API keys - leave blank to skip those integrations locally
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_API_KEY=
JOBDATALAKE_API_KEY=

RATE_LIMIT_LOGIN_LIMIT=100

# Frontend build args
VITE_API_BASE_URL=
VITE_ALLOW_SELF_REGISTER=true
