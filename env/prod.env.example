# PROD environment. Copy to env/prod.env on the production host and fill in real
# values. Never commit env/prod.env - it holds live secrets.
# Usage: docker compose --env-file env/prod.env up -d --build
#
# Every default below matches what docker-compose.yml already fell back to before
# environments were split out, so an existing prod host that keeps using its current
# .env file (instead of switching to env/prod.env) is unaffected by this change.

SPRING_PROFILES_ACTIVE=prod
POSTGRES_DB=jobapp_db

JWT_SECRET=REPLACE_ME_32_CHAR_MINIMUM_SECRET
CORS_ALLOWED_ORIGINS=https://your-domain.example

# Recommended for real prod: leave the admin seed OFF once you've logged in and
# created your real admin account, or at minimum change the password below.
# See ENVIRONMENTS.md for why this matters.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@jobportal.local
ADMIN_SEED_PASSWORD=REPLACE_ME_STRONG_PASSWORD

MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME

ADZUNA_APP_ID=REPLACE_ME
ADZUNA_APP_KEY=REPLACE_ME
FINDWORK_API_KEY=REPLACE_ME
JOBDATALAKE_API_KEY=REPLACE_ME

RATE_LIMIT_LOGIN_LIMIT=20

# Frontend build args - leave VITE_API_BASE_URL blank so the browser calls the same
# origin Caddy serves the frontend from (see comment in frontend/Dockerfile)
VITE_API_BASE_URL=
VITE_ALLOW_SELF_REGISTER=false
