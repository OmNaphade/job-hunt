# UAT environment - pre-release testing. Should run on its own host/VM, separate from
# prod, since every service in docker-compose.yml uses a fixed container_name and
# can't share a Docker host with another running stack.
# Copy to env/uat.env on the UAT host and fill in real values. Never commit env/uat.env.
# Usage: docker compose --env-file env/uat.env up -d --build

SPRING_PROFILES_ACTIVE=uat
POSTGRES_DB=jobapp_uat_db

# Generate a fresh secret, don't reuse dev's or prod's: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_32_CHAR_MINIMUM_SECRET
CORS_ALLOWED_ORIGINS=https://uat.your-domain.example

ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@jobportal.local
ADMIN_SEED_PASSWORD=REPLACE_ME_STRONG_PASSWORD

MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME

ADZUNA_APP_ID=REPLACE_ME
ADZUNA_APP_KEY=REPLACE_ME
FINDWORK_API_KEY=REPLACE_ME
JOBDATALAKE_API_KEY=REPLACE_ME

RATE_LIMIT_LOGIN_LIMIT=20

# Frontend build args - point at the UAT gateway/domain
VITE_API_BASE_URL=
VITE_ALLOW_SELF_REGISTER=true
